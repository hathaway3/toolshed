root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{c,h}]
indent_style = tab
indent_size = 8

[*.{asm,a,inc}]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab

[*.md]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2